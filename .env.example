# Copy to .env and/or .env.local (recommended for secrets).
# .env.local overrides .env and is gitignored.

# Discord bot token from the Developer Portal → Bot → Reset Token
# REQUIRED — never commit the real value.
DISCORD_BOT_TOKEN=

# Comma-separated Discord user snowflake IDs allowed to drive Cursor.
# REQUIRED — the bridge refuses to start if empty.
# Use * to let anyone in an allowlisted guild/channel drive Cursor (DMs stay closed
# unless you also list specific user IDs). * requires a guild or channel list.
DISCORD_ALLOWED_USER_IDS=

# Optional — comma-separated guild (server) snowflake IDs.
# When set, guild messages must come from one of these servers.
# With USER_IDS=* and this set (and CHANNEL_IDS empty), every channel in these guilds is open.
DISCORD_ALLOWED_GUILD_IDS=

# Comma-separated guild channel (or thread) snowflake IDs.
# Leave empty to allow DMs only (or, with USER_IDS=*, every channel in ALLOWED_GUILD_IDS).
# Threads under an allowlisted parent are also allowed.
DISCORD_ALLOWED_CHANNEL_IDS=

# Optional: browser / app identity label
APP_NAME=CursorDiscord

# Optional: Cursor Agent CLI binary (NOT the IDE `cursor` Electron shim).
# Windows typical: %LOCALAPPDATA%\cursor-agent\agent.cmd
# CURSOR_BIN=agent

# Multi-machine lease (same bot on Mac + PC). Channel both bridges can edit.
# BRIDGE_LEASE_CHANNEL_ID=
# BRIDGE_HOST=windows-pc
# BRIDGE_LEASE_STALE_MS=90000
# BRIDGE_FORCE=1

# Optional: default project key from projects.json
# DEFAULT_PROJECT=crm

# Optional: kill a Cursor run after N minutes (default 15)
# CURSOR_TIMEOUT_MIN=15

# Optional: different Cursor models for plan vs implement (omit = Auto).
# Research tip: stronger planner, faster coder. List: `cursor agent models`
# CURSOR_PLAN_MODEL=gpt-5.2
# CURSOR_AGENT_MODEL=cursor-grok-4.5-high
# CURSOR_ASK_MODEL=

# Optional: OpenAI API key for voice notes + Discord voice assistant (STT + TTS)
# OPENAI_API_KEY=sk-...

# Optional: OpenAI TTS voice for /join voice assistant (default alloy)
# VOICE_TTS_VOICE=alloy

# Voice STT backend (same OPENAI_API_KEY): realtime ≈ gpt-realtime-whisper (~$0.017/min),
# batch ≈ gpt-4o-mini-transcribe (~$0.003/min). Default realtime; falls back to batch on error
# (no tertiary whisper-1 fallback).
# VOICE_STT_MODE=realtime

# Optional: delete history/inbox + logs older than N days on startup (default 7)
# RETENTION_DAYS=7

# Optional: /preview tunnels (requires `brew install cloudflared` on the Mac)
# PREVIEW_DEFAULT_PORT=3000
# PREVIEW_CLOUDFLARED_BIN=cloudflared
# Comma-separated project:port overrides (also supported via projects.json "previewPorts")
# PREVIEW_PORTS=tagiser:3000,motocards:3000
