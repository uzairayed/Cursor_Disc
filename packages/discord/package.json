{
  "name": "@cursor-bridge/discord",
  "version": "1.0.0",
  "description": "Discord → Cursor Agent bridge",
  "type": "module",
  "main": "dist/index.js",
  "scripts": {
    "build": "npm run build -w @cursor-bridge/core && tsc",
    "typecheck": "npm run build -w @cursor-bridge/core && tsc --noEmit",
    "dev": "npm run build -w @cursor-bridge/core && tsx src/index.ts",
    "start": "node dist/index.js",
    "test": "npm run build -w @cursor-bridge/core && vitest run",
    "test:watch": "vitest"
  },
  "engines": {
    "node": ">=20"
  },
  "dependencies": {
    "@cursor-bridge/core": "*",
    "@discordjs/opus": "^0.10.0",
    "@discordjs/voice": "^0.19.2",
    "discord.js": "^14.22.1",
    "libsodium-wrappers": "^0.8.4",
    "prism-media": "^1.3.5"
  },
  "devDependencies": {
    "@types/node": "^22.13.10",
    "tsx": "^4.19.3",
    "typescript": "^5.8.2",
    "vitest": "^4.1.10"
  }
}
